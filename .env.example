# ─── Runtime ────────────────────────────────────────────────────────────
APP_ENV=development
DATA_DIR=./data
MODELS_DIR=./models
LOG_LEVEL=INFO

# ─── Server ─────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ─── Models ─────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
LLM_REPO_ID=Qwen/Qwen2.5-1.5B-Instruct-GGUF
LLM_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_N_CTX=4096
LLM_N_THREADS=4
LLM_N_GPU_LAYERS=0

# ─── MCP ────────────────────────────────────────────────────────────────
MCP_TRANSPORT=stdio

# ─── Hugging Face ───────────────────────────────────────────────────────
# Used ONLY for downloading models from HF Hub (no remote inference).
HF_TOKEN=your_hf_token_here
